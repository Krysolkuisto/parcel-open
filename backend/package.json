{
  "name": "parcel-open-backend",
  "version": "0.1.0",
  "description": "Open-source multi-carrier package tracking backend (17TRACK, AfterShip) for the Parcel Open apps",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "set-key": "node scripts/set-key.mjs",
    "doctor": "tsx --env-file-if-exists=.env src/doctor-cli.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
