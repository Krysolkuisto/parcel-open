# Required. Shared secret the apps send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Providers (at least one key for real data; with none, an offline mock provider is used).
# 17TRACK: https://api.17track.net  — the key is also the webhook signing secret.
TRACK17_API_KEY=
# AfterShip: https://www.aftership.com/docs/tracking
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# Optional: provider priority, comma separated (17track, aftership, mock).
# Default: every provider that has a key, 17track first.
# PROVIDERS=17track,aftership

# Optional
# PORT=8787
# HOST=127.0.0.1
# DATABASE_PATH=./data/parcel.db
# POLL_INTERVAL_MINUTES=30
# REFRESH_SPACING_MS=400
