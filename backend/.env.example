# Required. Shared secret the apps send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Providers (at least one key for real data; with none, an offline mock provider is used).
# 17TRACK: https://api.17track.net  — the key is also the webhook signing secret.
TRACK17_API_KEY=
# DHL (free, 250 calls/day): https://developer.dhl.com/api-reference/shipment-tracking
# Create an app subscribed to "Shipment Tracking - Unified" and copy its API key. DHL parcels only.
DHL_API_KEY=
# UPS (free): https://developer.ups.com — create an app, add the "Tracking" product, copy its Client ID and Secret. UPS parcels only.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# Ship24 (free API plan: 10 shipments/month, any carrier): https://www.ship24.com/tracking-api
# Pick the "Tracking API and Webhook" plan, not the per-call one.
SHIP24_API_KEY=
# AfterShip: https://www.aftership.com/docs/tracking
AFTERSHIP_API_KEY=
AFTERSHIP_WEBHOOK_SECRET=

# Optional: provider priority, comma separated (dhl, ups, 17track, aftership, ship24, mock).
# Default: every provider that has a key, free carrier APIs (dhl) first.
# PROVIDERS=17track,aftership

# Optional
# PORT=8787
# HOST=127.0.0.1
# DATABASE_PATH=./data/parcel.db
# POLL_INTERVAL_MINUTES=30
# REFRESH_SPACING_MS=400

# Map: place names from tracking events are looked up through a Nominatim service (OpenStreetMap by default),
# cached in the database. Only place names are sent. Set GEOCODER=off to disable.
# GEOCODER=nominatim
# GEOCODER_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=YourApp/1.0 (+https://example.com)
